# VLAD TENEV COMPANION — backend config.
# Copy to .env.local and fill in what you have. Every value is optional:
# with none of them set the app still boots, on mock data and canned chat.
# Check what's actually live at http://localhost:3000/api/health

# ---------------------------------------------------------------------------
# CHAT — Vlad's persona backend
# ---------------------------------------------------------------------------
# auto (default) | anthropic | openrouter
# "auto" uses whichever key is set below. If both are set, Anthropic wins —
# the persona impersonates a real public figure, and the stronger model holds
# the hard rules (no buy/sell calls, no impersonation) far more reliably.
# Set this explicitly to force one.
CHAT_PROVIDER=auto

# With no key at all, /api/chat returns canned in-character lines rather than
# failing, so the panel still works on a fresh clone.

# --- Option A: Anthropic (recommended for production) ---
ANTHROPIC_API_KEY=
VLAD_CHAT_MODEL=claude-opus-5

# --- Option B: OpenRouter (free models available; good for dev/demo) ---
# Default is "openrouter/free" — OpenRouter's Free Models Router, which
# auto-selects from whatever's currently free instead of naming one model.
# Pinning a specific ":free" model (e.g. deepseek/deepseek-chat-v3-0324:free)
# WILL break without notice: that exact model was pulled from the free tier
# mid-development of this project. If you want a specific model anyway, check
# https://openrouter.ai/models?q=free first — don't trust any id you've seen
# before, including ones in this file's git history.
# Free tier caveats: 20 req/min, 50/day on a fresh account (1000/day after
# ever buying $10 of credits), and free-tier prompts may be logged or trained
# on upstream. Don't send anything sensitive through it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional attribution on OpenRouter's leaderboards.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=VLAD TENEV COMPANION

VLAD_CHAT_RATE_LIMIT=20
VLAD_CHAT_RATE_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# ROBINHOOD CHAIN — EVM (Ethereum L2, Arbitrum Orbit stack)
# ---------------------------------------------------------------------------
# No defaults are guessed here. Take these from the official RH Chain docs;
# leaving one blank degrades that feature rather than pointing at a wrong network.
RH_CHAIN_RPC_URL=
RH_CHAIN_ID=
RH_CHAIN_NAME=Robinhood Chain
RH_CHAIN_NATIVE_SYMBOL=ETH

# Token URL bases. The address is appended with a "/".
# Explorer e.g. https://<rh-chain-explorer>/token
# DEX e.g. https://app.uniswap.org/#/tokens/<network> (Uniswap is integrated on RH Chain)
RH_CHAIN_EXPLORER_BASE=
RH_CHAIN_DEX_BASE=

# ---------------------------------------------------------------------------
# RADAR — where the live rows come from
# ---------------------------------------------------------------------------
# auto (default) picks coingecko > subgraph > alchemy > mock based on what's
# configured.
RADAR_SOURCE=auto
RADAR_CACHE_MS=15000

# Option A — CoinGecko / GeckoTerminal onchain API (recommended: easiest to
# set up, and the only option that returns real market cap + real liquidity
# in USD out of the box — the others return 0 for those until you wire a
# price feed / locker contract). CoinGecko has added explicit Robinhood Chain
# support (network id "robinhood").
# Free Demo key: coingecko.com -> sign up -> Developer Dashboard -> Create API
# key -> Demo. 10,000 calls/month, 100 calls/min.
COINGECKO_API_KEY=
COINGECKO_NETWORK=robinhood
COINGECKO_PLAN=demo

# Option B — subgraph / indexer. Best for discovery ("what just launched") if
# you're already running your own indexer.
# A Uniswap v3-schema subgraph on RH Chain works with the bundled query.
RADAR_SUBGRAPH_URL=

# Option C — Alchemy (an official RH Chain infra partner). Best for holder
# counts derived from Transfer logs. It reads per contract, so tell it which
# ones to measure.
ALCHEMY_API_KEY=
ALCHEMY_BASE_URL=
RADAR_WATCHLIST=

# ---------------------------------------------------------------------------
# NEWS — right-rail feed
# ---------------------------------------------------------------------------
# JSON array of { tag, text, time, url }. https urls only. Falls back to the
# bundled items when unset or unreachable.
NEWS_SOURCE_URL=
NEWS_CACHE_MS=300000
